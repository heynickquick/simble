# Public domain pointing to VPS (e.g. sms.nickquick.co)
DOMAIN=sms.example.com

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
MONGO_DATABASE=textbee

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_HEX_STRING

# Firebase Cloud Messaging
# Get from Firebase console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the entire private key INCLUDING -----BEGIN/END----- lines.
# In JSON, \n becomes a literal newline when parsed.
FIREBASE_PRIVATE_KEY=

# Optional: phase 2 bridge port
BRIDGE_PORT=4000

# Timezone
TZ=America/New_York
