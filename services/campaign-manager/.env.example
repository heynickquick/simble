PORT=4000

# MongoDB — matches the mongodb service in docker-compose.yml
MONGODB_URI=mongodb://mongo:27017/campaigns

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_HEX_STRING

# ============================================================
# SMS GATEWAY (choose one or use mock for testing)
# ============================================================

# Option 1: sms-relay (our own, no FCM/Firebase — recommended)
SMS_RELAY_URL=http://sms-relay:4010
SMS_RELAY_SECRET=CHANGE_ME_SAME_AS_RELAY

# Option 2: textbee (legacy, requires Firebase)
# TEXTBEE_API_URL=https://sms.yourdomain.com
# TEXTBEE_API_KEY=your_textbee_api_key_here

# Option 3: mock mode (simulates sends, useful for testing without a phone)
SMS_GATEWAY_MOCK=false

# Webhook to call for delivery reports (campaign-manager /api/webhooks/textbee)
SIMBLE_WEBHOOK_URL=https://simble.yourdomain.com/api/webhooks/textbee

# Rate limit: max requests per IP per minute
RATE_LIMIT_PER_MIN=120
