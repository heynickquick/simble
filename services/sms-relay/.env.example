PORT=4010

# MongoDB — matches the mongodb service in docker-compose.yml.
# Format includes auth (admin user from .env, authSource=admin).
MONGODB_URI=mongodb://admin:CHANGE_ME@simble-mongodb:27017/simble_relay?authSource=admin

# Shared secret between campaign-manager and sms-relay.
# campaign-manager uses this to authenticate sends.
SMS_RELAY_SECRET=CHANGE_ME_LONG_RANDOM

# Max time a phone can hold a long-poll request (ms). Default 30s.
LONG_POLL_TIMEOUT_MS=30000
