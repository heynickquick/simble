# textbee API
TEXTBEE_API_URL=https://sms.your-domain.com
TEXTBEE_API_KEY=your_textbee_api_key

# Comma-separated list of textbee device IDs to monitor
DEVICE_IDS=device_id_1,device_id_2

# Telegram alerts (optional but recommended)
# Create a bot with @BotFather, get the token, message the bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tuning
POLL_INTERVAL_MS=60000
OFFLINE_THRESHOLD_MS=300000
ALERT_COOLDOWN_MS=1800000
