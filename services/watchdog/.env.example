# sms-relay (use container-internal hostname when in docker-compose)
SMS_RELAY_URL=http://sms-relay:4010
SMS_RELAY_SECRET=ff1514095ef66c292e21c4019c0c27fda204536e62c180d045fcde8455cf2760

# Comma-separated list of sms-relay device _ids (Mongo ObjectId, NOT the token)
# Find them: curl -H "Authorization: Bearer $SMS_RELAY_SECRET" $SMS_RELAY_URL/devices
DEVICE_IDS=6a837ab2c144882074ad7f16,6a837dbe5bd66928171eb8ad

# Telegram alerts (optional but recommended)
# Create a bot with @BotFather, get the token, message the bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tuning
POLL_INTERVAL_MS=60000
OFFLINE_THRESHOLD_MS=300000
ALERT_COOLDOWN_MS=1800000
